using System.Net;
using AppForSEII.API.Data;
using AppForSEII.API.Models;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;

namespace AppForSEII.API.Controllers
{
    [Route("api/[controller]")]
    [ApiController]
    public class InscripcionesCompController : ControllerBase
    {
        private readonly ApplicationDbContext _context;
        private readonly ILogger<InscripcionesCompController> _logger;

        public InscripcionesCompController(
            ApplicationDbContext context,
            ILogger<InscripcionesCompController> logger)
        {
            _context = context;
            _logger = logger;
        }

        // POST: InscripcionesComp/CreateInscripcion
        [HttpPost]
        [Route("[action]")]
        [ProducesResponseType(typeof(InscripcionComp), (int)HttpStatusCode.Created)]
        [ProducesResponseType(typeof(string), (int)HttpStatusCode.Conflict)]
        public async Task<IActionResult> CrearInscripcion(InscripcionComp inscripcion)
        {
            // La fecha de inscripción la pone el servidor
            inscripcion.FechaInscripcion = DateTime.Now;

            _context.Add(inscripcion);

            try
            {
                await _context.SaveChangesAsync();
            }
            catch (Exception ex)
            {
                _logger.LogError(ex.Message);
                return Conflict("Error" + ex.Message);
            }

            return CreatedAtAction("GetInscripcion", new { id = inscripcion.Id }, inscripcion);
        }
    }
}